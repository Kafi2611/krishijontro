# Copy this file to ".env" and put in your real values. Never commit .env.

# Neon PostgreSQL. DATABASE_URL is the POOLED string (host contains "-pooler").
# Use sslmode=verify-full here: the app's "pg" driver then checks Neon's certificate fully.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.ap-southeast-1.aws.neon.tech/krishijontro?sslmode=verify-full"
# DIRECT_URL is the same string WITHOUT "-pooler" (used only for migrations).
DIRECT_URL="postgresql://USER:PASSWORD@ep-example-123456.ap-southeast-1.aws.neon.tech/krishijontro?sslmode=require"

# Auth.js secret used to sign the login cookie.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-string"
